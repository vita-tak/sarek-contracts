# Backend wallet — signs all on-chain transactions
BACKEND_WALLET_PRIVATE_KEY=0x

# Active chain — switch between: sepolia, zksyncSepolia, zksyncMainnet
CHAIN=sepolia

# RPC URLs
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ZKSYNC_SEPOLIA_RPC_URL=https://sepolia.era.zksync.dev
ZKSYNC_MAINNET_RPC_URL=https://mainnet.era.zksync.io

# Contract addresses per chain - filled in after deploy
SEPOLIA_CONTRACT_ADDRESS=0x
ZKSYNC_SEPOLIA_CONTRACT_ADDRESS=
ZKSYNC_MAINNET_CONTRACT_ADDRESS=

# MMR verifier contract address
SEPOLIA_MMR_VERIFIER_ADDRESS=0x